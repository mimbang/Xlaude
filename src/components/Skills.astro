---
// Skills.astro

const pillars = [
  {
    index:   '01',
    title:   'Backend & API Engineering',
    summary: 'REST architecture, scalable backend systems, authentication flows, and practical business logic design.',
    skills: [
      { name: 'Python',                  level: 86, note: 'Automation · Logic · Scripting' },
      { name: 'Django',                  level: 84, note: 'ORM · Admin · Architecture' },
      { name: 'Django REST Framework',   level: 82, note: 'APIs · Auth · Serializers' },
      { name: 'PostgreSQL',              level: 76, note: 'Relations · Optimization · Queries' },
      { name: 'API Design',              level: 80, note: 'REST · Scalability · Security' },
    ],
  },

  {
    index:   '02',
    title:   'Data & Intelligent Systems',
    summary: 'Data manipulation, predictive systems, analytical thinking, and practical AI-oriented workflows.',
    skills: [
      { name: 'Data Science',            level: 78, note: 'Analysis · Prediction · Cleaning' },
      { name: 'Machine Learning',        level: 72, note: 'Models · Training · Evaluation' },
      { name: 'Data Visualization',      level: 74, note: 'Charts · Insights · Dashboards' },
      { name: 'Pandas',                  level: 77, note: 'Processing · Filtering · Aggregation' },
      { name: 'AI System Design',        level: 70, note: 'Automation · Logic · Use cases' },
    ],
  },

  {
    index:   '03',
    title:   'Mobile & Frontend',
    summary: 'Cross-platform mobile applications, responsive interfaces, and practical user-focused experiences.',
    skills: [
      { name: 'React Native',            level: 73, note: 'Mobile UI · Navigation · Components' },
      { name: 'JavaScript',              level: 76, note: 'Logic · Async · ES6+' },
      { name: 'TypeScript',              level: 68, note: 'Typing · Maintainability' },
      { name: 'Expo',                    level: 70, note: 'Mobile workflow · Builds' },
      { name: 'UI/UX Thinking',          level: 74, note: 'Practicality · Simplicity · Flow' },
    ],
  },

  {
    index:   '04',
    title:   'Infrastructure & Systems',
    summary: 'Deployment workflows, asynchronous systems, containerized environments, and scalable backend operations.',
    skills: [
      { name: 'Docker',                  level: 79, note: 'Containers · Compose · Deployment' },
      { name: 'Redis',                   level: 75, note: 'Cache · Queues · Pub/Sub' },
      { name: 'Celery',                  level: 71, note: 'Async tasks · Workers · Scheduling' },
      { name: 'Linux',                   level: 73, note: 'CLI · Services · Environment' },
      { name: 'System Architecture',     level: 77, note: 'Scalability · Design · Reliability' },
    ],
  },

  {
    index:   '05',
    title:   'Product & Innovation',
    summary: 'Problem-solving mindset focused on realistic products adapted to local and social realities.',
    skills: [
      { name: 'Product Thinking',        level: 88, note: 'Utility · Simplicity · Adoption' },
      { name: 'Problem Solving',         level: 90, note: 'Analysis · Strategy · Adaptation' },
      { name: 'Business Logic Design',   level: 82, note: 'Flows · User needs · Scalability' },
      { name: 'Startup Vision',          level: 80, note: 'Market fit · Innovation · Execution' },
      { name: 'Critical Thinking',       level: 89, note: 'Questioning · Optimization · Realism' },
    ],
  },

  {
    index:   '06',
    title:   'Soft Skills',
    summary: 'Analytical mindset, autonomous learning, creativity, and resilience under complex challenges.',
    skills: [
      { name: 'Autonomous Learning',     level: 95, note: 'Fast adaptation · Curiosity' },
      { name: 'Creativity',              level: 90, note: 'Ideas · Concepts · Innovation' },
      { name: 'Resilience',              level: 88, note: 'Persistence · Pressure handling' },
      { name: 'Analytical Thinking',     level: 91, note: 'Logic · Breakdown · Reasoning' },
      { name: 'Vision & Ambition',       level: 93, note: 'Long-term thinking · Growth mindset' },
    ],
  },
];
---

<section id="skills" class="py-28">
  <div class="max-w-5xl mx-auto px-6">

    <!-- Section header -->
    <div class="flex items-end justify-between pb-7 mb-12 border-b border-[#161D30]">
      <div>
        <p class="label mb-2.5">// 02 — Technical Pillars</p>
        <h2 class="font-sans font-semibold text-[1.65rem] text-[#E6EBF4] tracking-[-0.02em]">
          Engineering Stack
        </h2>
      </div>
      <span class="font-mono text-[0.62rem] text-[#3D4E6B] tracking-[0.08em] hidden sm:block">
        {pillars.reduce((s, p) => s + p.skills.length, 0)} technologies
      </span>
    </div>

    <!-- Pillar grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      {pillars.map((pillar) => (
        <article class="group relative bg-[#0D1120] border border-[#161D30] hover:border-[rgba(16,185,129,0.22)] rounded-md overflow-hidden transition-all duration-300 shadow-[0_2px_16px_rgba(0,0,0,0.35),0_1px_0_rgba(255,255,255,0.03)]">

          <!-- Top accent bar -->
          <div class="h-px w-full bg-gradient-to-r from-transparent via-[rgba(16,185,129,0)] to-transparent group-hover:via-[rgba(16,185,129,0.35)] transition-all duration-500"></div>

          <!-- Header -->
          <div class="px-5 pt-5 pb-4 border-b border-[#161D30]">
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-[0.6rem] text-[#3D4E6B] tracking-[0.16em] uppercase">[{pillar.index}]</span>
              <!-- Tiny emerald dot -->
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]/30 group-hover:bg-[#10B981]/70 transition-colors duration-300"></span>
            </div>
            <h3 class="font-sans font-semibold text-[#C4CEDF] text-sm mb-2.5 tracking-[-0.01em]">
              {pillar.title}
            </h3>
            <p class="font-sans text-[#5A6A88] text-[0.78rem] leading-[1.6] font-light">
              {pillar.summary}
            </p>
          </div>

          <!-- Skills list -->
          <ul class="px-5 py-4 space-y-3.5">
            {pillar.skills.map((skill) => (
              <li class="group/skill">
                <div class="flex items-baseline justify-between gap-2 mb-1.5">
                  <span class="font-mono text-[0.68rem] text-[#10B981]/80 tracking-[0.04em] whitespace-nowrap">
                    {skill.name}
                  </span>
                  <span class="font-mono text-[0.58rem] text-[#3D4E6B] text-right leading-tight hidden sm:block">
                    {skill.note}
                  </span>
                </div>
                <!-- Precision level bar -->
                <div class="h-[2px] w-full bg-[#161D30] rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-[#10B981]/60 to-[#10B981] rounded-full"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>
              </li>
            ))}
          </ul>

        </article>
      ))}
    </div>

  </div>
</section>
