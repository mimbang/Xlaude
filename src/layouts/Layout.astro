---
export interface Props {
  title?:       string;
  description?: string;
}
const {
  title       = 'François Noah | Full-Stack Engineer',
  description = 'Full-Stack Engineer specialized in Django, geospatial systems, real-time architectures, and React Native mobile engineering.',
} = Astro.props;

const nav = ['About', 'Skills', 'Projects', 'Contact'];
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    /* ─── Reset ───────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; }

    html {
      background: #0B0F19;
      color: #C4CEDF;
      font-family: 'Inter', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-feature-settings: 'cv02','cv03','cv04','cv11';
    }

    /* ─── Blueprint grid background ──────────────────── */
    body {
      min-height: 100vh;
      background-color: #0B0F19;
      background-image:
        /* dot intersections */
        radial-gradient(circle, rgba(16,185,129,0.09) 1px, transparent 1px),
        /* fine grid */
        linear-gradient(rgba(16,185,129,0.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(16,185,129,0.022) 1px, transparent 1px),
        /* coarse grid */
        linear-gradient(rgba(16,185,129,0.048) 1px, transparent 1px),
        linear-gradient(90deg, rgba(16,185,129,0.048) 1px, transparent 1px),
        /* top radial glow */
        radial-gradient(ellipse 90% 45% at 50% -5%, rgba(16,185,129,0.055) 0%, transparent 65%);
      background-size:
        72px 72px,
        18px 18px,
        18px 18px,
        72px 72px,
        72px 72px,
        100% 100%;
      background-attachment: fixed;
    }

    /* ─── Cursor glow (JS-free, CSS-only radial follow) ─ */
    /* Soft ambient glow tethered to ::before on body     */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(
        600px circle at var(--cx, 50%) var(--cy, 30%),
        rgba(16,185,129,0.04) 0%,
        transparent 70%
      );
      pointer-events: none;
      z-index: 0;
      transition: background 0.25s ease;
    }

    /* ─── Scrollbar ───────────────────────────────────── */
    ::-webkit-scrollbar       { width: 3px; }
    ::-webkit-scrollbar-track { background: #04060E; }
    ::-webkit-scrollbar-thumb { background: #161D30; border-radius: 2px; }
    ::-webkit-scrollbar-thumb:hover { background: #10B981; }

    /* ─── Selection ───────────────────────────────────── */
    ::selection { background: rgba(16,185,129,0.22); color: #F0F4FA; }

    /* ─── Global utility classes ─────────────────────── */
    .label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(16,185,129,0.45);
      user-select: none;
    }
    .rule {
      border: none; height: 1px;
      background: linear-gradient(90deg, transparent 0%, #161D30 15%, #1C2640 50%, #161D30 85%, transparent 100%);
    }
    .rule-em {
      border: none; height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(16,185,129,0.12) 30%, rgba(16,185,129,0.25) 50%, rgba(16,185,129,0.12) 70%, transparent 100%);
    }

    /* ─── Entrance animations ─────────────────────────── */
    .enter { opacity: 0; animation: slideUp 0.55s cubic-bezier(0.16,1,0.3,1) forwards; }
    .enter:nth-child(1)  { animation-delay: 0.08s; }
    .enter:nth-child(2)  { animation-delay: 0.16s; }
    .enter:nth-child(3)  { animation-delay: 0.24s; }
    .enter:nth-child(4)  { animation-delay: 0.32s; }
    .enter:nth-child(5)  { animation-delay: 0.40s; }
    .enter:nth-child(6)  { animation-delay: 0.48s; }
    .enter:nth-child(7)  { animation-delay: 0.56s; }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0);    }
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }
    .caret { animation: blink 1.1s step-end infinite; }

    /* ─── Page fade-in on load ────────────────────────── */
    main { animation: fadeIn 0.4s ease-out both; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  </style>
</head>

<body>
  <!-- ── Cursor glow tracker (zero dependencies) ──────── -->
  <script>
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth  * 100).toFixed(1) + '%';
      const y = (e.clientY / window.innerHeight * 100).toFixed(1) + '%';
      document.body.style.setProperty('--cx', x);
      document.body.style.setProperty('--cy', y);
    }, { passive: true });
  </script>

  <!-- ── Navbar ─────────────────────────────────────────── -->
  <header class="fixed top-0 inset-x-0 z-50 border-b border-[#161D30]/90 backdrop-blur-xl bg-[#0B0F19]/75">
    <nav class="max-w-5xl mx-auto px-6 h-11 flex items-center justify-between">
      <span class="font-mono text-[0.65rem] text-em-500 tracking-[0.2em] uppercase select-none">
        FN<span class="text-[#3D4E6B] mx-1">/</span>eng
      </span>
      <div class="flex items-center gap-7">
        {nav.map((item) => (
          <a
            href={`#${item.toLowerCase()}`}
            class="font-mono text-[0.62rem] text-[#5A6A88] hover:text-[#10B981] tracking-[0.14em] uppercase transition-colors duration-150"
          >
            {item}
          </a>
        ))}
      </div>
    </nav>
  </header>

  <!-- ── Main content ───────────────────────────────────── -->
  <main class="relative z-10">
    <slot />
  </main>

  <!-- ── Footer ────────────────────────────────────────── -->
  <footer class="relative z-10 mt-28 border-t border-[#161D30]">
    <div class="max-w-5xl mx-auto px-6 py-7 flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="label opacity-50">// EOF — portfolio.v2 — 2025</span>
      <div class="flex items-center gap-6">
        {[
          { label: 'GitHub',   href: 'https://github.com'   },
          { label: 'LinkedIn', href: 'https://linkedin.com' },
          { label: 'Email',    href: 'mailto:francois@example.com' },
        ].map(({ label, href }) => (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener' : undefined}
            class="font-mono text-[0.62rem] text-[#3D4E6B] hover:text-[#10B981] tracking-[0.12em] uppercase transition-colors duration-150"
          >
            {label}
          </a>
        ))}
      </div>
    </div>
  </footer>
</body>
</html>
